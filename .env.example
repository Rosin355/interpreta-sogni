VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SITE_URL=https://tuo-dominio.lovable.app

# ── Edge Function secrets (set via: supabase secrets set KEY=value) ──────────
# These are server-side only — never expose to the client or commit real values.

# AI Provider (Lovable is always the default — no change needed for production)
# AI_PROVIDER_TEST_OVERRIDE=anthropic   # "anthropic" | "openai" — testers only
# AI_PROVIDER_TEST_USER_IDS=uuid1,uuid2  # comma-separated Supabase user UUIDs
# ANTHROPIC_API_KEY=sk-ant-...           # only needed when override = anthropic
# OPENAI_API_KEY=sk-...                  # only needed when override = openai

# RevenueCat webhook (leave unset until you're ready to activate)
# REVENUECAT_WEBHOOK_SECRET=your-rc-webhook-secret

# Admin user IDs (comma-separated Supabase UUIDs) — grants admin plan
# ADMIN_USER_IDS=uuid1,uuid2
